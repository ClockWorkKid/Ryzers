# MolmoAct2 + LeRobot LoRA training image — AMD Instinct MI300X (gfx942).
# Validated on an AMD Instinct MI300X (gfx942) node: builds clean, 10-step LoRA-VLM
# smoke passes end-to-end (rc=0, ckpt saved).
#
# Base: official ROCm 7.2 / py3.12 / torch 2.10 (multi-arch, includes gfx942).
#   docker build -t molmoact2-lerobot-train:rocm942 -f Dockerfile.instinct-gfx942 .
FROM rocm/pytorch:rocm7.2_ubuntu24.04_py3.12_pytorch_release_2.10.0
SHELL ["/bin/bash", "-lc"]

# Exact LeRobot commit that ships the molmoact2 policy (0.5.2 dev; not on PyPI).
ARG LEROBOT_COMMIT=052d329

# Route hipBLASLt NOT_SUPPORTED fallbacks for the small action-expert GEMMs.
ENV TORCH_BLAS_PREFER_HIPBLASLT=0

# System deps: ffmpeg headers so PyAV can build (no manylinux wheel matched here).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg pkg-config \
      libavformat-dev libavcodec-dev libavdevice-dev libavutil-dev \
      libavfilter-dev libswscale-dev libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

# Constraint pins the base torch trio by PUBLIC version (local +rocm segment
# stripped) so pip keeps the installed ROCm wheels instead of pulling CUDA ones.
# We install lerobot[molmoact2] plus the [dataset] deps EXCEPT torchcodec, which
# hard-pins torch and does not load on ROCm; video decoding uses pyav (av).
RUN set -e; \
    python -c "import torch;print('torch=='+torch.__version__.split('+')[0])" > /tmp/con.txt; \
    python -c "import torchvision;print('torchvision=='+torchvision.__version__.split('+')[0])" >> /tmp/con.txt 2>/dev/null || true; \
    python -c "import torchaudio;print('torchaudio=='+torchaudio.__version__.split('+')[0])" >> /tmp/con.txt 2>/dev/null || true; \
    echo "=== torch constraint ==="; cat /tmp/con.txt; \
    git clone https://github.com/huggingface/lerobot.git /opt/lerobot; \
    cd /opt/lerobot && git checkout ${LEROBOT_COMMIT}; \
    pip install --no-cache-dir -c /tmp/con.txt -e ".[molmoact2]" \
      "datasets>=4.7.0,<5.0.0" "pandas>=2.0.0,<3.0.0" "pyarrow>=21.0.0,<30.0.0" \
      "av>=12,<14" "accelerate>=1.14,<2.0"

# Patch: make processor-override validation warn-and-skip instead of raising on
# unmatched keys. On --resume, lerobot re-applies generic override keys
# (normalizer_processor / unnormalizer_processor) that the molmoact2 pipeline
# names differently (molmoact2_masked_normalizer / ..._unnormalizer). The saved
# steps already carry their normalization state, so skipping is safe; without
# this, resuming a molmoact2 run crashes with KeyError.
RUN python - <<'PY'
p = "/opt/lerobot/src/lerobot/processor/pipeline.py"
s = open(p, encoding="utf-8").read()
OLD = '''        raise KeyError(
            f"Override keys {list(remaining_override_keys)} do not match any step in the saved configuration. "
            f"Available step keys: {available_keys}. "
            f"Make sure override keys match exact step class names or registry names."
        )'''
NEW = '''        import logging as _logging
        _logging.getLogger("lerobot").warning(
            f"Override keys {list(remaining_override_keys)} do not match any step in the saved configuration. "
            f"Available step keys: {available_keys}. Skipping unmatched overrides "
            f"(safe on resume: saved steps retain their persisted state)."
        )
        return'''
assert OLD in s, "resume patch target not found in pipeline.py"
open(p, "w", encoding="utf-8").write(s.replace(OLD, NEW, 1))
print("resume override patch applied")
PY

# Bake in ROI-guided pre-ViT (stage-D) vision-token pruning: overlay our modified
# molmoact2 policy files (+ new roi_prune.py) onto the editable lerobot install.
# Runtime no-op unless policy.roi_prune_enable=true (defaults keep the ViT intact).
COPY roi_overlay/ /opt/lerobot/src/lerobot/policies/molmoact2/
# COPY inherits build-context perms/owner (root); make the package world-readable
# and traversable so the non-root training user can import it.
RUN chmod -R a+rX /opt/lerobot/src/lerobot/policies/molmoact2

# Sanity: imports + the torch trio must stay ROCm; verify config + ROI knobs.
RUN python - <<'PY'
import torch, lerobot, transformers, peft, datasets, av, numpy
assert "+rocm" in torch.__version__ or torch.version.hip, f"torch not ROCm: {torch.__version__}"
print("torch", torch.__version__, "| hip", torch.version.hip)
print("lerobot", getattr(lerobot,"__version__","?"), "| transformers", transformers.__version__,
      "| peft", peft.__version__, "| datasets", datasets.__version__,
      "| av", av.__version__, "| numpy", numpy.__version__)
from lerobot.policies.molmoact2.configuration_molmoact2 import MolmoAct2Config
c = MolmoAct2Config()
print("MolmoAct2Config OK; enable_lora_vlm default:", c.enable_lora_vlm)
from lerobot.policies.molmoact2 import roi_prune as rp
assert hasattr(c, "roi_prune_enable") and hasattr(c, "roi_prune_keep_frac")
print("ROI baked in: roi_prune_select default:", c.roi_prune_select,
      "| keep_frac:", c.roi_prune_keep_frac, "| module:", rp.__name__)
PY
