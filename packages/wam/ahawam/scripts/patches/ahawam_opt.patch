+    def _ensure_stacked_weights(
+        self, *, device: torch.device, dtype: torch.dtype
+    ) -> dict[str, torch.Tensor]:
+        """Lazily stack the per-layer proj weights into [L, ...] tensors.
+
+        Enables the batched fast path to replace the ~num_layers tiny per-layer
+        GEMMs/einsums with layer-batched ops (fewer kernel launches). Cached and
+        rebuilt only if the target device/dtype changes.
+        """
+        cache = getattr(self, "_stacked_cache", None)
+        if (
+            cache is not None
+            and cache["device"] == device
+            and cache["dtype"] == dtype
+        ):
+            return cache
+        with torch.no_grad():
+            qln = [cast(nn.LayerNorm, self.layer_query_proj[l][0]) for l in range(self.num_layers)]
+            qlin = [cast(nn.Linear, self.layer_query_proj[l][1]) for l in range(self.num_layers)]
+            dln = [cast(nn.LayerNorm, self.layer_delta_proj[l][0]) for l in range(self.num_layers)]
+            d1 = [cast(nn.Linear, self.layer_delta_proj[l][1]) for l in range(self.num_layers)]
+            d2 = [cast(nn.Linear, self.layer_delta_proj[l][3]) for l in range(self.num_layers)]
+
+            def stack(mods, attr):
+                return torch.stack([getattr(m, attr).detach() for m in mods]).to(
+                    device=device, dtype=dtype
+                )
+
+            cache = {
+                "device": device,
+                "dtype": dtype,
+                "qln_w": stack(qln, "weight"),   # [L, D]
+                "qln_b": stack(qln, "bias"),     # [L, D]
+                "qlin_w": stack(qlin, "weight"), # [L, A, D]
+                "qlin_b": stack(qlin, "bias"),   # [L, A]
+                "dln_w": stack(dln, "weight"),   # [L, A]
+                "dln_b": stack(dln, "bias"),     # [L, A]
+                "d1_w": stack(d1, "weight"),     # [L, A, A]
+                "d1_b": stack(d1, "bias"),       # [L, A]
+                "d2_w": stack(d2, "weight"),     # [L, 2A, A]
+                "d2_b": stack(d2, "bias"),       # [L, 2A]
+                "qln_eps": float(qln[0].eps),
+                "dln_eps": float(dln[0].eps),
+            }
+        self._stacked_cache = cache
+        return cache
+
